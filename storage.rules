rules_version = '2';

// Starter rules: files under /public are readable by anyone (e.g. product and
// gallery images); only admins (custom claim { admin: true }) can upload them.
// Everything else is locked down until a feature needs it.
service firebase.storage {
  match /b/{bucket}/o {
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
