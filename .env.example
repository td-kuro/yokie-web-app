# Copy this file to `.env.local` (local development) and fill in your values.
# Never commit real values — `.env*` files other than this one are git-ignored.
#
# Firebase web config: Firebase console → Project settings → General → Your apps → Web app.
# These values are embedded in the browser bundle and are not secret; access is
# controlled by Firestore / Storage Security Rules (see firestore.rules, storage.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Where catalogue data comes from and where form submissions go:
#   local    — bundled mock data in src/data; submissions are simulated (default)
#   firebase — Cloud Firestore (requires the Firebase values above)
VITE_DATA_SOURCE=local
